# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Playwright IAP cookie store (interactive auth output)
tests/.auth/

# Playwright run artifacts (regenerated every run — never commit)
test-results/
playwright-report/

# E2E dev-server lock (scripts/e2e-server.mjs) — per-run, PID-scoped
.e2e-server.lock

# Frontend source under src/data/ is application code, not pipeline data —
# re-include it despite the repo-root `data/` ignore (which targets GCS-backed
# parquet/CSV datasets, not TypeScript modules).
!src/data/
!src/data/**

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Network captures. Kept out of the repo because a HAR is a verbatim recording
# of a browsing session: request/response bodies, cookies, auth headers and
# analytics identifiers. Useful to hand to a debugging session, never something
# to commit.
*.har
har.json
docs/har.json

# Claude Code local session settings (permissions allowlist) — personal, not repo config
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
