                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="au_a1" value="isAdmin (IAP email == ADMIN_EMAIL)&#xa;→ straight into /admin" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c7cc4;strokeWidth=1.5;fontSize=10;fontColor=#1f2933;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="76" y="440" width="320" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="au_a2" value="non-admin → access-denied card&#xa;(no token fallback, nothing stored)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c7cc4;strokeWidth=1.5;fontSize=10;fontColor=#1f2933;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="440" y="440" width="300" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="au_ae_au_a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=0;endArrow=block;endFill=1;strokeColor=#7cae7a;strokeWidth=1.5;fontSize=9;fontColor=#52606d;labelBackgroundColor=#ffffff;" parent="1" source="au_a1" target="au_a2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="au_a3" value="GET /api/admin/routes with the&#xa;signed-in identity (Bearer ID token)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c7cc4;strokeWidth=1.5;fontSize=10;fontColor=#1f2933;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="780" y="440" width="300" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="au_ae_au_a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=0;endArrow=block;endFill=1;strokeColor=#7cae7a;strokeWidth=1.5;fontSize=9;fontColor=#52606d;labelBackgroundColor=#ffffff;" parent="1" source="au_a2" target="au_a3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="au_a4" value="is_admin_email(identity) → allow&#xa;else 401/403" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c7cc4;strokeWidth=1.5;fontSize=10;fontColor=#1f2933;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="440" width="320" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="au_ae_au_a4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=0;endArrow=block;endFill=1;strokeColor=#7cae7a;strokeWidth=1.5;fontSize=9;fontColor=#52606d;labelBackgroundColor=#ffffff;" parent="1" source="au_a3" target="au_a4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="au_d1" value="No IAP header → /api/me returns { email: null } → isAdmin=false → app fully usable; Admin needs the admin role on the signed-in account (user_roles). Vite dev :5173 proxies /api → FastAPI :8000." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b8794;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontColor=#1f2933;" parent="1" vertex="1">
                    <mxGeometry x="76" y="598" width="1400" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="au_warn" value="⚠ Auth caveats (documented, not fixed here):&#xa;• Backend trusts the plaintext X-Goog-Authenticated-User-Email header — no JWT assertion validation (main.py._iap_user_email, routers/admin.py). Safe only because IAP fronts Cloud Run.&#xa;• ADMIN_EMAIL hardcoded in useUser.ts + routers/admin.py.&#xa;• Sidebar hiding /admin is cosmetic — real gate is _require_admin on the API.&#xa;• No Firebase / username-password anywhere; programmatic SA auth currently returns 401 (browser SSO is the only working path)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#d93025;strokeWidth=1.5;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#1f2933;" parent="1" vertex="1">
                    <mxGeometry x="40" y="718" width="1000" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="au_note" value="Local dev quickstart: npm run dev (Vite :5173) + uvicorn :8000 — no auth needed for data endpoints.&#xa;E2E: Playwright cloud project reuses a captured IAP cookie (e2e:cloud:auth)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff6e0;strokeColor=#d6b656;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#1f2933;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="718" width="480" height="120" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
