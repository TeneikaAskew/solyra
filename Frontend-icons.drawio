                <mxCell id="au_b6" value="Sidebar gates /admin&#xa;isAdmin = email == ADMIN_EMAIL" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c7cc4;strokeWidth=1.5;fontSize=10;fontColor=#1f2933;align=center;verticalAlign=middle;" parent="1" vertex="1">
